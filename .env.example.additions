# Marketplace deal engine + scanner — names only. Never commit secret values.
# Set on Fly with: fly secrets set NAME=value -a market-radar

# Required for live Facebook Marketplace Watch scans:
# APIFY_API_TOKEN=
# APIFY_FB_MARKETPLACE_ACTOR=datascrapers/facebook-marketplace
# APIFY_FB_TASK_ID=

# Optional ingest webhook (fbdeals):
# MARKET_RADAR_INGEST_SECRET=
# APIFY_WEBHOOK_SECRET=

# Preferred Twilio auth (ClamCrew production-style):
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# Fallback Twilio auth:
# TWILIO_AUTH_TOKEN=
# Preferred sender:
# TWILIO_MESSAGING_SERVICE_SID=
# Fallback sender:
# TWILIO_FROM_NUMBER=
# TWILIO_PHONE_NUMBER=
# Owner HOT DEAL destination (not the Twilio sending number):
# MARKET_RADAR_ALERT_TO_NUMBER=

# Provider selection (scanner / fallback actors)
# MARKET_RADAR_FB_PROVIDER=rigelbytes
# APIFY_FB_RIGEL_ACTOR=rigelbytes/facebook-marketplace
# APIFY_FB_K1RA_ACTOR=k1ra/facebook-marketplace-scraper

# Optional Apify Task IDs (create in Apify Console, then set the names below)
# APIFY_FB_DISCOVERY_HOT_TASK_ID=
# APIFY_FB_DISCOVERY_NORMAL_TASK_ID=
# APIFY_FB_DETAIL_TASK_ID=
# APIFY_FB_FALLBACK_TASK_ID=

# Kill switches / cadence
MARKETPLACE_SCANNER_ENABLED=1
MARKETPLACE_ENABLE_SCHEDULER=0
MARKETPLACE_SCANNER_SCHEDULER=0
MARKETPLACE_PROVIDER_RIGEL_ENABLED=1
MARKETPLACE_PROVIDER_K1RA_ENABLED=1
MARKETPLACE_ALLOW_FALLBACK=0
MARKETPLACE_MAX_ITEMS_CANARY=8
MARKETPLACE_STAGE2_MAX_PER_RUN=3
